{
    "name": "arthmoon/blog",
    "description": "Блог на чистом PHP со Smarty и MySQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-pdo": "*",
        "psr/log": "^3.0",
        "smarty/smarty": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff"
    }
}
